{
  "name": "celco-grade-report-dispatcher",
  "version": "1.0.0",
  "description": "Despachante automático de boletins com resumo por LLM (desafio técnico Backoffice & Automation)",
  "main": "dist/cli.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.spec.json --noEmit",
    "test": "jest",
    "dispatch": "npm run build && node --env-file-if-exists=.env dist/cli.js dispatch",
    "demo": "npm run build && node --env-file-if-exists=.env dist/cli.js dispatch --file data/grades.sample.csv --period 2026-1S --fresh"
  },
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "csv-parse": "^7.0.3",
    "nodemailer": "^10.2.1",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  },
  "private": false,
  "engines": {
    "node": ">=20.6"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "transform": {
      "^.+.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.spec.json"
        }
      ]
    }
  }
}
