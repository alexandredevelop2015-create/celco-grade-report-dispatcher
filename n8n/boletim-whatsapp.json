{
  "name": "Boletim - WhatsApp (Evolution GO)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "boletim-whatsapp",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1f0c1d2-0001-4a00-9000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "boletim-whatsapp"
    },
    {
      "parameters": {
        "jsCode": "// Valida segredo, payload e duplicidade (idempotencyKey). Não envia nada.\nconst req = $input.first().json;\nconst secret = $env.N8N_WEBHOOK_SECRET;\nconst got = req.headers?.['x-webhook-secret'];\nconst b = req.body ?? {};\n\nif (!secret || got !== secret) {\n  return [{ json: { status: 'unauthorized', httpCode: 401 } }];\n}\n\nconst phone = String(b.phone ?? '');\nconst text = String(b.text ?? '');\nconst key = String(b.idempotencyKey ?? '');\nif (!/^\\d{10,15}$/.test(phone) || !text || text.length > 1000 || !key) {\n  return [{ json: { status: 'invalid', httpCode: 400 } }];\n}\n\nconst data = $getWorkflowStaticData('global');\ndata.sent = data.sent ?? {};\nif (data.sent[key]) {\n  return [{ json: { status: 'duplicate', httpCode: 200 } }];\n}\n\nreturn [{ json: { status: 'ok', httpCode: 200, phone, text, key } }];"
      },
      "id": "a1f0c1d2-0002-4a00-9000-000000000002",
      "name": "Validar e deduplicar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.status }}",
              "value2": "ok"
            }
          ]
        }
      },
      "id": "a1f0c1d2-0003-4a00-9000-000000000003",
      "name": "Pode enviar?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [440, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_API_URL }}/send/text",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.EVOLUTION_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $json.phone, text: $json.text }) }}",
        "options": {
          "timeout": 12000
        }
      },
      "id": "a1f0c1d2-0004-4a00-9000-000000000004",
      "name": "Evolution GO - enviar texto",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, -100]
    },
    {
      "parameters": {
        "jsCode": "// Só marca como enviada DEPOIS do envio: se o Evolution falhar, o retry do app reenvia.\nconst { key } = $('Validar e deduplicar').first().json;\nconst data = $getWorkflowStaticData('global');\ndata.sent = data.sent ?? {};\ndata.sent[key] = Date.now();\n\n// Limpa chaves com mais de 48h e limita o tamanho do cache.\nconst limit = Date.now() - 48 * 3600 * 1000;\nfor (const k of Object.keys(data.sent)) if (data.sent[k] < limit) delete data.sent[k];\nconst keys = Object.keys(data.sent);\nif (keys.length > 5000) keys.sort((a, b) => data.sent[a] - data.sent[b]).slice(0, keys.length - 5000).forEach((k) => delete data.sent[k]);\n\nreturn [{ json: { status: 'sent', httpCode: 200 } }];"
      },
      "id": "a1f0c1d2-0005-4a00-9000-000000000005",
      "name": "Marcar como enviada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, -100]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: $json.status }) }}",
        "options": {
          "responseCode": "={{ $json.httpCode }}"
        }
      },
      "id": "a1f0c1d2-0006-4a00-9000-000000000006",
      "name": "Responder (enviado)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
