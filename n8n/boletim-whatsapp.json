        "options": {
          "responseCode": "={{ $json.httpCode }}"
        }
      },
      "id": "a1f0c1d2-0007-4a00-9000-000000000007",
      "name": "Responder (recusado/duplicado)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [660, 120]
    }
  ],
