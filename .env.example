# --- LLM ---------------------------------------------------------------
# fake = determinístico e gratuito (padrão); anthropic = API real
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
# Preço em USD por milhão de tokens. Ajuste ao preço vigente do modelo escolhido.
LLM_PRICE_INPUT_PER_MTOK=1
LLM_PRICE_OUTPUT_PER_MTOK=5
LLM_MAX_OUTPUT_TOKENS=300
LLM_REQUESTS_PER_SEC=5
LLM_TIMEOUT_MS=20000
# Orçamento por execução: ao estourar, o resto cai no resumo determinístico (fallback)
MAX_RUN_COST_USD=5
FALLBACK_ON_LLM_FAILURE=true

# Injeção de falhas para demonstrar retry/circuit breaker (apenas LLM_PROVIDER=fake)
FAKE_LLM_FAILURE_RATE=0
FAKE_LLM_LATENCY_MS=0

# --- Notificação -------------------------------------------------------
# console = imprime o e-mail; smtp = Mailpit local (docker compose up -d); resend = API do Resend
NOTIFIER=console
# Chave só de envio (Resend > API Keys > Sending access). NUNCA commitar o .env
RESEND_API_KEY=
# Plano gratuito do Resend aceita 2 requisições/s
RESEND_REQUESTS_PER_SEC=2
# WhatsApp via n8n + Evolution GO (vazio = desligado). Ver docs/WHATSAPP.md
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
WHATSAPP_REQUESTS_PER_SEC=1
# Secretaria: recebe um e-mail de auditoria a cada alteração feita pela interface (vazio = desligado)
ADMIN_EMAIL=
# Porta da interface web (npm run ui)
UI_PORT=3000
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Secretaria Académica <secretaria@exemplo.pt>"
NOTIFY_RATE_PER_SEC=10

# --- Resiliência e concorrência ---------------------------------------
CONCURRENCY=5
RETRY_ATTEMPTS=4
RETRY_BASE_MS=500
RETRY_MAX_MS=15000
BREAKER_THRESHOLD=5
BREAKER_COOLDOWN_MS=30000

# --- Regras académicas (escala portuguesa 0-20) ------------------------
GRADE_SCALE_MAX=20
PASS_MARK=10

OUTPUT_DIR=./out
LOG_LEVEL=info
